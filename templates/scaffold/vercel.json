{
  "version": 2,
  "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/posts",
      "dest": "/posts/index.html"
    },
    {
      "src": "/posts/(.*)",
      "dest": "/posts/$1/index.html"
    },
    {
      "src": "/tags/(.*)",
      "dest": "/tags/$1/index.html"
    },
    {
      "src": "/categories/(.*)",
      "dest": "/categories/$1/index.html"
    },
    {
      "src": "/topics/(.*)",
      "dest": "/topics/$1/index.html"
    },
    {
      "src": "/keywords/(.*)",
      "dest": "/keywords/$1/index.html"
    },
    {
      "src": "/series/(.*)",
      "dest": "/series/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/_geulte/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_geulte/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/search-index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
