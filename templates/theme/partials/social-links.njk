{% set emailLink = site.social.email or site.email or (site.author.email if site.author and site.author.email) %}
{% set githubLink = site.social.github %}
{% set twitterLink = site.social.twitter or site.social.x %}
{% set linkedinLink = site.social.linkedin %}
{% set instagramLink = site.social.instagram %}
{% set youtubeLink = site.social.youtube %}
{% set blueskyLink = site.social.bluesky %}
{% set websiteLink = site.social.website %}

{% if emailLink or githubLink or twitterLink or linkedinLink or instagramLink or youtubeLink or blueskyLink or websiteLink %}
<div class="site-footer-social" role="list" aria-label="연락처 및 소셜 미디어">
  {% if emailLink %}
  {% set mailtoHref = emailLink if emailLink.startsWith('mailto:') else 'mailto:' + emailLink %}
  <a href="{{ mailtoHref }}" class="footer-social-btn" role="listitem" aria-label="이메일 보내기" title="이메일: {{ emailLink.replace('mailto:', '') }}">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="20" height="16" x="2" y="4" rx="2"/>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
    </svg>
  </a>
  {% endif %}

  {% if githubLink %}
  {% set ghHref = githubLink if githubLink.startsWith('http') else 'https://github.com/' + githubLink %}
  <a href="{{ ghHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="GitHub 프로필" title="GitHub">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
    </svg>
  </a>
  {% endif %}

  {% if twitterLink %}
  {% set twHref = twitterLink if twitterLink.startsWith('http') else 'https://x.com/' + twitterLink %}
  <a href="{{ twHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter) 프로필" title="X (Twitter)">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>
  {% endif %}

  {% if linkedinLink %}
  {% set liHref = linkedinLink if linkedinLink.startsWith('http') else 'https://linkedin.com/in/' + linkedinLink %}
  <a href="{{ liHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn 프로필" title="LinkedIn">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
    </svg>
  </a>
  {% endif %}

  {% if instagramLink %}
  {% set igHref = instagramLink if instagramLink.startsWith('http') else 'https://instagram.com/' + instagramLink %}
  <a href="{{ igHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="Instagram 프로필" title="Instagram">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
      <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
    </svg>
  </a>
  {% endif %}

  {% if blueskyLink %}
  {% set bskyHref = blueskyLink if blueskyLink.startsWith('http') else 'https://bsky.app/profile/' + blueskyLink %}
  <a href="{{ bskyHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="Bluesky 프로필" title="Bluesky">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566 1.01 1.402 1.487.666 2.058-.094 2.648-.22 3.864.22 5.068c.55 1.506 2.37 5.163 3.322 6.705-1.74-.298-3.606.18-4.223 1.253-.787 1.368.106 3.193 1.83 4.12 4.316 2.32 8.01-1.077 10.851-6.346 2.841 5.269 6.535 8.666 10.851 6.346 1.724-.927 2.617-2.752 1.83-4.12-.617-1.073-2.483-1.551-4.223-1.253.952-1.542 2.772-5.199 3.322-6.705.44-1.204.314-2.42-.446-3.01-.736-.571-1.9-.048-4.534.747C16.046 4.747 13.087 8.686 12 10.8z"/>
    </svg>
  </a>
  {% endif %}

  {% if youtubeLink %}
  {% set ytHref = youtubeLink if youtubeLink.startsWith('http') else 'https://youtube.com/' + youtubeLink %}
  <a href="{{ ytHref }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="YouTube 채널" title="YouTube">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
  </a>
  {% endif %}

  {% if websiteLink %}
  <a href="{{ websiteLink }}" class="footer-social-btn" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="개인 웹사이트" title="웹사이트">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" x2="22" y1="12" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
  </a>
  {% endif %}
</div>
{% endif %}
