{#
  partials/comments.njk — 댓글 섹션
  comments.provider === 'giscus' 일 때 Giscus 위젯을 렌더링합니다.
  다크/라이트 테마 전환 시 giscus 테마도 자동으로 동기화됩니다.
#}

{% if comments and comments.provider === 'giscus' and comments.giscus %}
  {% set g = comments.giscus %}

<section class="comments-section" aria-label="댓글">
  <h2 class="comments-heading">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    댓글
  </h2>

  {# Giscus 위젯 — data 속성으로 설정을 받습니다 #}
  <div class="giscus-wrapper">
    <script
      src="https://giscus.app/client.js"
      data-repo="{{ g.repo }}"
      data-repo-id="{{ g.repoId }}"
      data-category="{{ g.category }}"
      data-category-id="{{ g.categoryId }}"
      data-mapping="{{ g.mapping }}"
      data-strict="{{ '1' if g.strict else '0' }}"
      data-reactions-enabled="{{ '1' if g.reactionsEnabled else '0' }}"
      data-emit-metadata="{{ '1' if g.emitMetadata else '0' }}"
      data-input-position="{{ g.inputPosition }}"
      data-theme="dark"
      data-lang="{{ g.lang }}"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  {# 테마 전환 시 giscus에 메시지 전송 #}
  <script>
  (function () {
    'use strict';

    // Giscus의 현재 테마를 반환합니다
    function getGiscusTheme(htmlTheme) {
      return htmlTheme === 'dark' ? 'dark' : 'light';
    }

    // Giscus iframe에 테마 변경 메시지를 보냅니다
    function sendGiscusTheme(theme) {
      var iframe = document.querySelector('iframe.giscus-frame');
      if (!iframe) return;
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: theme } } },
        'https://giscus.app'
      );
    }

    // 초기 테마 적용 (DOM이 로드된 후 iframe이 생성되면 동기화)
    function syncInitialTheme() {
      var htmlTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      var giscusTheme = getGiscusTheme(htmlTheme);

      // Giscus script data-theme 초기 설정 (이미 스크립트에서 설정됨)
      // iframe이 생성된 후 메시지로 동기화
      var observer = new MutationObserver(function () {
        var iframe = document.querySelector('iframe.giscus-frame');
        if (iframe) {
          observer.disconnect();
          // iframe 로드 후 메시지 전송
          iframe.addEventListener('load', function () {
            sendGiscusTheme(giscusTheme);
          });
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });
    }

    // 테마 토글 버튼 클릭 감지
    function observeThemeChanges() {
      var htmlEl = document.documentElement;
      var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          if (m.attributeName === 'data-theme') {
            var newTheme = htmlEl.getAttribute('data-theme') || 'dark';
            sendGiscusTheme(getGiscusTheme(newTheme));
          }
        });
      });
      observer.observe(htmlEl, { attributes: true, attributeFilter: ['data-theme'] });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        syncInitialTheme();
        observeThemeChanges();
      });
    } else {
      syncInitialTheme();
      observeThemeChanges();
    }
  })();
  </script>
</section>
{% endif %}
