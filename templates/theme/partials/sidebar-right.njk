<div class="sidebar-inner">
  <!-- 목차 (TOC - 본문에 목차가 있을 때 상단 표시) -->
  {% if toc and toc | length > 0 %}
  <nav class="toc-nav" aria-label="{{ t('sidebar.toc') }}">
    <h3 class="sidebar-section-title">{{ t('sidebar.toc') }}</h3>
    <ol class="toc-list">
      {% for item in toc %}
      <li class="toc-item toc-depth-{{ item.depth }}">
        <a href="#{{ item.id }}" class="toc-link">{{ item.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <!-- 최신글 / 인기글 탭 위젯 (우측 사이드바 상시 노출) -->
  <div class="sidebar-section posts-tab-widget">
    <div class="posts-tab-nav" role="tablist" aria-label="{{ t('sidebar.recent_posts') }} 및 {{ t('sidebar.popular_posts') }}">
      <button type="button" class="posts-tab-btn active" id="tabRecent" role="tab" aria-selected="true" aria-controls="widgetRecentPosts">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>{{ t('sidebar.recent_posts') }}</button>
      <button type="button" class="posts-tab-btn" id="tabPopular" role="tab" aria-selected="false" aria-controls="widgetPopularPosts">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>{{ t('sidebar.popular_posts') }}</button>
    </div>
    <div class="posts-tab-body">
      {% include "partials/recent-posts.njk" %}
      {% include "partials/popular-posts.njk" %}
    </div>
  </div>

  <!-- 백링크 (클라이언트 사이드 렌더링) -->
  {% include "partials/backlinks.njk" %}

  <!-- 연관 글 (서버 사이드 정적 데이터 기반 필터링) -->
  {% include "partials/related-posts.njk" %}
</div>
