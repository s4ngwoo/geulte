{% extends "layout.njk" %}

{% block content %}
<div class="page-list">
  <header class="page-header">
    <h1 class="page-title">{{ listTitle }}</h1>
    <div class="page-header-actions">
      <p class="post-count" id="postCount">{{ posts | length }}개의 글</p>
      {% if listType == 'category' and currentTaxonomy %}
      <a href="{{ localePrefix }}/categories/{{ currentTaxonomy | lower | replace(' ', '-') }}/rss.xml"
         class="rss-link" aria-label="RSS 피드 구독" title="RSS 피드">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        RSS
      </a>
      {% endif %}
    </div>
  </header>

  {# posts 전체 목록 페이지에서만 필터 패널 노출 #}
  {% if listType == 'posts' %}
  {% include "partials/filter-panel.njk" %}
  {% endif %}

  <div id="staticPostList">
    {% if posts | length == 0 %}
    <p class="empty-state">글이 없습니다.</p>
    {% else %}
    <ul class="post-list" id="postList">
      {% for post in posts %}
      <li class="post-card">
        <article>
          <div class="post-card-meta">
            {% if post.category and listType != 'category' %}
            <a href="{{ localePrefix }}/categories/{{ post.category | urlencode }}" class="post-category">{{ post.category }}</a>
            {% endif %}
            <time datetime="{{ post.date | isodate }}" class="post-date">{{ post.date | dateformat }}</time>
            {% if post.type %}
            <span class="post-type post-type--{{ post.type }}">{{ post.type }}</span>
            {% endif %}
          </div>
          <h2 class="post-card-title">
            <a href="{{ localePrefix }}/posts/{{ post.slug }}">{{ post.title }}</a>
          </h2>
          {% if post.excerpt %}
          <p class="post-card-excerpt">{{ post.excerpt }}</p>
          {% endif %}
          {% if post.tags | length > 0 and listType != 'tag' %}
          <div class="post-tags">
            {% for tag in post.tags %}
            <a href="{{ localePrefix }}/tags/{{ tag | urlencode }}" class="tag">#{{ tag }}</a>
            {% endfor %}
          </div>
          {% endif %}
          {% if post.topics | length > 0 and listType != 'topic' %}
          <div class="post-tags">
            {% for topic in post.topics %}
            <a href="{{ localePrefix }}/topics/{{ topic | urlencode }}" class="tag tag--topic">{{ topic }}</a>
            {% endfor %}
          </div>
          {% endif %}
          {% if post.keywords | length > 0 and listType != 'keyword' %}
          <div class="post-tags">
            {% for kw in post.keywords %}
            <a href="{{ localePrefix }}/keywords/{{ kw | urlencode }}" class="tag tag--keyword">{{ kw }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </article>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</div>

{% if listType == 'posts' and supabaseUrl %}
<script>
  window.__GEULTE_FILTER__ = {
    supabaseUrl: {{ supabaseUrl | tojson | safe }},
    supabaseKey: {{ supabaseKey | tojson | safe }},
    allTags: {{ sidebar.tags | tojson | safe }},
    allTopics: {{ sidebar.topics | tojson | safe }},
    allKeywords: {{ sidebar.keywords | tojson | safe }},
    allCategories: {{ sidebar.categories | tojson | safe }}
  };
</script>
<script src="/_geulte/js/filter.js" defer></script>
{% endif %}
{% endblock %}
