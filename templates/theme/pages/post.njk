{% extends "layout.njk" %}

{% block content %}
<article class="post-article" itemscope itemtype="https://schema.org/BlogPosting">

  <!-- 글 헤더 -->
  <header class="post-header">
    <div class="post-header-meta">
      {% if post.category %}
      <a href="{{ localePrefix }}/categories/{{ post.category | urlencode }}" class="post-category">{{ post.category }}</a>
      {% endif %}
      {% if post.type %}
      <span class="post-type post-type--{{ post.type }}">{{ post.type }}</span>
      {% endif %}
    </div>

    <h1 class="post-title" itemprop="name headline">{{ post.title }}</h1>

    <div class="post-dates">
      <time datetime="{{ post.date | isodate }}" itemprop="datePublished">
        {{ post.date | dateformat }}
      </time>
      {% if post.updated %}
      <span class="post-updated">
        (수정: <time datetime="{{ post.updated | isodate }}" itemprop="dateModified">{{ post.updated | dateformat }}</time>)
      </span>
      {% endif %}
      {% if supabaseUrl %}
      <span class="post-view-count" title="조회수">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <span id="postViewCount">—</span>
      </span>
      {% endif %}
    </div>

    {% if post.tags | length > 0 %}
    <div class="post-tags">
      {% for tag in post.tags %}
      <a href="{{ localePrefix }}/tags/{{ tag | urlencode }}" class="tag">#{{ tag }}</a>
      {% endfor %}
    </div>
    {% endif %}

    {% if post.series %}
    <div class="post-series-notice">
      📚 <a href="{{ localePrefix }}/series/{{ post.series | urlencode }}">{{ post.series }}</a> 시리즈
      {% if seriesIndex and seriesTotal %}
      <span class="series-progress-inline">{{ seriesIndex }}/{{ seriesTotal }}</span>
      {% endif %}
    </div>
    {% endif %}
  </header>

  <!-- 모바일/태블릿용 스티키 목차 바 (< 960px 상단 고정) -->
  {% if toc and toc | length > 0 %}
  <div class="mobile-sticky-toc" id="mobileStickyToc">
    <details class="mobile-sticky-toc-details" id="mobileStickyTocDetails">
      <summary class="mobile-sticky-toc-summary" aria-label="목차 열기/닫기">
        <span class="mobile-toc-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
          목차:
        </span>
        <span class="mobile-toc-active-title" id="mobileTocCurrentTitle">소개</span>
        <span class="details-arrow">▾</span>
      </summary>
      <div class="mobile-sticky-toc-dropdown">
        <ol class="toc-list">
          {% for item in toc %}
          <li class="toc-item toc-depth-{{ item.depth }}">
            <a href="#{{ item.id }}" class="toc-link">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ol>
      </div>
    </details>
  </div>
  {% endif %}

  <!-- 본문 -->
  <div class="post-body" itemprop="articleBody">
    {{ post.contentHtml | safe }}
  </div>

  <!-- 글 푸터 -->
  <footer class="post-footer">
    {% if post.topics | length > 0 %}
    <div class="post-footer-section">
      <span class="post-footer-label">주제:</span>
      {% for topic in post.topics %}
      <a href="{{ localePrefix }}/topics/{{ topic | urlencode }}" class="tag tag--topic">{{ topic }}</a>
      {% endfor %}
    </div>
    {% endif %}

    {% if post.keywords | length > 0 %}
    <div class="post-footer-section">
      <span class="post-footer-label">키워드:</span>
      {% for kw in post.keywords %}
      <a href="{{ localePrefix }}/keywords/{{ kw | urlencode }}" class="tag tag--keyword">{{ kw }}</a>
      {% endfor %}
    </div>
    {% endif %}

    {# 시리즈 이전/다음 (하단) #}
    {% include "partials/series-nav.njk" %}

    {# 모바일 / 태블릿용 정보 (백링크, 연관 글) #}
    <div class="post-mobile-drawer" aria-label="연관 정보">
      <div class="post-mobile-section mobile-backlinks">
        {% include "partials/backlinks.njk" %}
      </div>

      <div class="post-mobile-section mobile-related">
        {% include "partials/related-posts.njk" %}
      </div>
    </div>
  </footer>

  {# 댓글 영역 #}
  {% include "partials/comments.njk" %}
</article>

{% if supabaseUrl %}
<script data-post-slug="{{ post.slug }}">
  // post slug를 body에 주입
  document.body.dataset.postSlug = {{ post.slug | tojson | safe }};
</script>
<script src="/scripts/track-view.js" defer></script>
{% endif %}
{% endblock %}
