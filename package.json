{
  "name": "geulte",
  "version": "0.1.0",
  "description": "Obsidian 스타일 마크다운 볼트를 다중 분류(taxonomy) 기반 정적 블로그로 변환하는 오픈소스 프레임워크",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "geulte": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "public"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blog",
    "static-site-generator",
    "obsidian",
    "markdown",
    "zettelkasten",
    "taxonomy",
    "wikilinks"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^4.4.3",
    "@supabase/supabase-js": "^2.45.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "js-yaml": "^4.1.0",
    "minisearch": "^7.1.0",
    "nunjucks": "^3.2.4",
    "ora": "^8.1.0",
    "picocolors": "^1.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "remark-wiki-link": "^2.0.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "slug": "^9.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.16.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sharp": "^0.31.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
